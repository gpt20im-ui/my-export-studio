# Copy this file to ".env" ONLY when you are ready to connect real services.
# Never put secret keys here. Anything starting with EXPO_PUBLIC_ is packed
# into the app and can be read by anyone who installs it.

# URL of YOUR OWN backend that talks to the AI model (the AI key lives on that
# server, never in the app). Leave empty to keep using the built-in mock AI.
EXPO_PUBLIC_AI_BACKEND_URL=

# Firebase web config (these values are not secrets, but keep them out of git).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
